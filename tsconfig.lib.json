{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/index.ts", "src/types.ts", "src/components/**/*.ts", "src/components/**/*.tsx", "src/foundations/**/*.ts"],
  "exclude": ["src/App.tsx", "src/main.tsx"]
}
